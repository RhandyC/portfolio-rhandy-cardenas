---
import { siteConfig } from "../config";
import Presentations from "./Presentations.astro";
const experiences = [...siteConfig.experience.filter(exp => !exp.title.startsWith("Teaching Assistant")), ...siteConfig.experience.filter(exp => exp.title.startsWith("Teaching Assistant"))];
const hasExperience = siteConfig.experience && experiences.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="px-6 py-16 md:py-20 scroll-mt-20">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] xl:grid-cols-[minmax(0,1fr)_300px] gap-10 lg:gap-12 items-start">
          <div class="lg:col-span-2">
            <h2 class="text-3xl md:text-4xl font-bold text-[#e2e8f0]">
              Professional experience
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="min-w-0">
            <div class="relative">
              {experiences.map((exp, index) => (
                <div class="relative mb-8 last:mb-0">
                  {/* Timeline dot at top of card */}
                  <div
                    class="absolute left-0 -top-2 w-4 h-4 bg-[#0a0f1e] dark:bg-slate-800 border-2 rounded-full -translate-x-1/2 z-20 transition-all duration-300"
                    style={`border-color: ${siteConfig.accentColor}; background-color: ${siteConfig.accentColor}`}
                  />

                  {/* Connecting line below card */}
                  {index < experiences.length - 1 && (
                    <div class="absolute left-0 bottom-0 w-0.5 h-8 bg-[#334155] -translate-x-1/2 translate-y-full z-10" />
                  )}

                  {/* Experience card */}
                  <div class="bg-[#0a0f1e] rounded-xl shadow-sm border border-[#334155] p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300">
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-4">
                      <div>
                        <h3 class="text-lg sm:text-xl font-semibold text-[#e2e8f0]">
                          {exp.title}
                        </h3>
                        <p
                          class="text-base sm:text-lg"
                          style={`color: ${siteConfig.accentColor}`}
                        >
                          {exp.company}
                        </p>
                      </div>
                      <span class="text-xs sm:text-sm text-[#94a3b8] shrink-0 sm:ml-4 mt-2 sm:mt-0">
                        {exp.dateRange}
                      </span>
                    </div>

                    <ul class="space-y-2">
                      {exp.bullets.map((bullet) => (
                        <li class="flex items-start">
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0" />
                          <span class="text-sm leading-relaxed text-[#b8c5d8]">
                            {bullet}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <aside class="min-w-0 lg:sticky lg:top-24" aria-label="Research videos"><Presentations /></aside>
        </div>
      </div>
    </section>
  )
}
