---
const groups = [
  {title: "AI & Decision-Making", items: "MDP / POMDP · POMCP / Monte Carlo Tree Search · Dynamic Programming · Deep RL: DQN, Policy Gradients, Actor-Critic · Machine Learning & Deep Learning"},
  {title: "Robotics & Validation", items: "ROS 2 · IPG CarMaker · CARLA · Gazebo · MATLAB/Simulink · SIL / VIL · Prototype-vehicle testing"},
  {title: "Programming & Frameworks", items: "Python · C++ · PyTorch · Keras · scikit-learn · Git · Linux · Visual Studio"},
  {title: "Engineering & Embedded Systems", items: "Catia V5 · SolidWorks · STM32 · Arduino · LabVIEW"},
];
---
<section id="about" class="px-6 py-16 md:py-20 bg-[#0f1729] scroll-mt-20">
  <div class="max-w-6xl mx-auto">
    <p class="text-xs uppercase tracking-[0.2em] text-[#60a5fa] mb-3">Technical toolkit</p>
    <h2 class="text-3xl md:text-4xl font-bold mb-8">Core competencies</h2>
    <div class="grid md:grid-cols-2 gap-6">
      {groups.map((group) => (
        <div class="border-t border-[#334155] pt-5">
          <h3 class="text-base font-semibold mb-3">{group.title}</h3>
          <p class="text-sm leading-loose text-[#94a3b8]">{group.items}</p>
        </div>
      ))}
    </div>
  </div>
</section>
