---
const links = [
  {href: '#experience', label: 'Experience'},
  {href: '#about', label: 'Expertise'},
  {href: '#academic-projects', label: 'Projects'},
  {href: '#publications', label: 'Publications'},
  {href: '#education', label: 'Education'},
  {href: '#credentials', label: 'Courses'},
];
---
<header id="header" class="sticky top-0 z-50 border-b border-[#334155]/60 bg-[#0a0f1e]/95 backdrop-blur-md">
  <nav aria-label="Main navigation" class="max-w-6xl mx-auto px-6 py-4 overflow-x-auto">
    <ul class="flex items-center gap-5 md:gap-8 md:justify-center text-xs md:text-sm whitespace-nowrap">
      {links.map((link) => <li><a href={link.href} class="text-[#cbd5e1] hover:text-[#60a5fa] transition-colors">{link.label}</a></li>)}
    </ul>
  </nav>
</header>
