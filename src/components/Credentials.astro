---
import { siteConfig } from "../config";
---
<section id="credentials" class="px-6 py-20 bg-[#0f1729]">
  <div class="max-w-5xl mx-auto grid lg:grid-cols-[2fr_1fr] gap-12">
    <div>
      <h2 class="text-3xl font-bold text-[#e2e8f0] mb-8">AI Courses & Certifications</h2>
      <div class="space-y-5">
        {siteConfig.certifications.map((course) => (
          <article class="border-l-2 border-[#3b82f6] pl-5 py-1">
            <p class="text-xs text-[#60a5fa] mb-2">{course.issuer} · {course.date}</p>
            <h3 class="font-semibold text-[#e2e8f0]">{course.name}</h3>
            <p class="text-sm text-[#94a3b8] mt-2 leading-relaxed">{course.description}</p>
          </article>
        ))}
      </div>
    </div>
    <div>
      <h2 class="text-3xl font-bold text-[#e2e8f0] mb-8">Languages</h2>
      <ul class="space-y-4">
        {siteConfig.languages.map((language) => (
          <li class="flex justify-between gap-4 border-b border-[#334155] pb-3 text-sm">
            <span class="text-[#e2e8f0]">{language.name}</span>
            <span class="text-[#94a3b8]">{language.level}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
