---
import { siteConfig } from "../config";
type ProjectImage = { src: string; alt: string; caption: string; width: number; height: number };
type Project = { name: string; description: string; link: string; skills: string[]; images?: ProjectImage[] };
const projects: Project[] = siteConfig.academicProjects;
const illustrated = projects.filter((project) => project.images?.length);
const remaining = projects.filter((project) => !project.images?.length);
---

{projects.length > 0 && (
  <section id="academic-projects" class="py-16 md:py-20 px-6 bg-[#0f1729]" aria-labelledby="projects-heading">
    <div class="max-w-5xl mx-auto">
      <div class="mb-10">
        <h2 id="projects-heading" class="text-3xl md:text-4xl font-bold text-[#e2e8f0] mb-4">Projects & Leadership</h2>
        <div class="w-24 h-1 bg-[#3b82f6] rounded-full" />
      </div>
      <div class="space-y-5">
        {[...illustrated, ...remaining].map((project) => (
          <article class:list={["grid gap-5 sm:gap-7 items-center p-5 sm:p-6 bg-[#141824] border border-[#334155] rounded-xl transition-colors hover:border-[#3b82f6]/70", project.images?.length ? 'sm:grid-cols-[180px_minmax(0,1fr)] lg:grid-cols-[220px_minmax(0,1fr)]' : 'grid-cols-1']}>
            {project.images?.length && <div class="space-y-4 max-w-[220px] w-full">
            {project.images?.map((photo) => (
              <figure>
                <a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`View full image: ${photo.caption}`} class="block rounded-lg overflow-hidden focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#60a5fa]">
                  <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" class="block w-full h-auto object-contain" />
                </a>
                <figcaption class="text-xs text-[#94a3b8] mt-3 leading-relaxed">{photo.caption}</figcaption>
              </figure>
            ))}
            </div>}
            <div class="min-w-0 flex flex-col gap-4">
              <h3 class="text-xl font-semibold text-[#e2e8f0] leading-snug">{project.name}</h3>
              <p class="text-sm text-[#b8c5d8] leading-relaxed">{project.description}</p>
              <ul aria-label="Skills used" class="flex flex-wrap gap-2 mt-auto pt-1">
                {project.skills.map((skill) => <li class="px-2.5 py-1 border border-[#334155] text-[#94a3b8] rounded-md text-xs">{skill}</li>)}
              </ul>
              {project.link && <a href={project.link} target="_blank" rel="noopener noreferrer" aria-label={`Learn more about ${project.name}`} class="self-start text-sm text-[#60a5fa] hover:underline">{project.link.includes('github.com') ? 'View on GitHub' : 'Explore project'} ↗</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
