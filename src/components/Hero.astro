---
import { siteConfig } from "../config";
import DownloadCV from "./DownloadCV.astro";
import ScholarIcon from "./ScholarIcon.astro";
---

<section
  id="hero"
  class="hero relative isolate bg-[#0a0f1e] overflow-hidden"
  aria-labelledby="hero-name"
>
  <img src="/images/hero/autonomous-driving-concept.webp" alt="" aria-hidden="true" width="1672" height="941" fetchpriority="high" class="hero-background" />
  <div class="hero-shade absolute inset-0" aria-hidden="true"></div>
  <div class="relative max-w-6xl mx-auto px-6 py-14 md:py-20 lg:py-24 w-full">
  <div class="hero-copy text-center md:text-left space-y-5">
    <!-- Name -->
    <h1 id="hero-name" class="text-4xl md:text-5xl lg:text-6xl font-bold text-[#e2e8f0] tracking-tight leading-[1.1]">
      {siteConfig.name}
    </h1>

    <!-- Title -->
    <p class="text-lg md:text-xl text-[#60a5fa] font-medium">
      {siteConfig.title}
    </p>

    <p class="text-sm md:text-base leading-relaxed text-[#cbd5e1]">
      <span class="sr-only">Planning safer autonomous driving.</span>
      <span class="typewriter" aria-hidden="true">Planning safer autonomous driving.</span>
    </p>

    <!-- Affiliation -->
    <div class="flex flex-col items-center md:items-start gap-2 text-[#b8c5d8]">
      <div class="flex flex-wrap justify-center md:justify-start items-center gap-3 text-xs">
        <span>Groupe Renault</span>
        <span class="text-[#334155]">×</span>
        <span>Université de Technologie de Compiègne</span>
      </div>
      <div class="text-xs text-[#94a3b8]">
        Heudiasyc UTC Laboratory
      </div>
    </div>

    <p class="text-xs text-[#94a3b8]">PhD defense scheduled for December 2026</p>

    <div class="hero-actions flex flex-wrap items-center justify-center md:justify-start gap-3 pt-2">
      <a href="#academic-projects" class="inline-flex items-center justify-center gap-3 rounded-lg border border-[#60a5fa]/60 bg-[#142b48]/80 px-6 py-3 text-sm font-semibold text-[#e2e8f0] hover:bg-[#23466a] transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#60a5fa]">Explore my projects <span aria-hidden="true">→</span></a>
      <DownloadCV />
    </div>

    <!-- Social links -->
    <div class="flex flex-wrap justify-center md:justify-start gap-2 pt-3">
      {
        siteConfig.social?.email && (
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="group flex items-center gap-2 px-4 py-2 rounded-lg bg-[#1a1f2e] border border-[#334155] text-[#94a3b8] hover:border-[#3b82f6] hover:text-[#60a5fa] transition-all duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
              <path d="M3 7l9 6l9 -6" />
            </svg>
            <span class="text-sm font-medium">Email</span>
          </a>
        )
      }
      {
        siteConfig.social?.linkedin && (
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-2 px-4 py-2 rounded-lg bg-[#1a1f2e] border border-[#334155] text-[#94a3b8] hover:border-[#3b82f6] hover:text-[#60a5fa] transition-all duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M8 11v5" />
              <path d="M8 8v.01" />
              <path d="M12 16v-5" />
              <path d="M16 16v-3a2 2 0 1 0 -4 0" />
              <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
            </svg>
            <span class="text-sm font-medium">LinkedIn</span>
          </a>
        )
      }
      {
        siteConfig.social?.github && (
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-2 px-4 py-2 rounded-lg bg-[#1a1f2e] border border-[#334155] text-[#94a3b8] hover:border-[#3b82f6] hover:text-[#60a5fa] transition-all duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
            </svg>
            <span class="text-sm font-medium">GitHub</span>
          </a>
        )
      }
    {siteConfig.social.googleScholar && (
        <a href={siteConfig.social.googleScholar} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-4 py-2 rounded-lg bg-[#1a1f2e] border border-[#334155] text-[#94a3b8] hover:border-[#3b82f6] hover:text-[#60a5fa] transition-colors">
          <ScholarIcon size={18} />
          <span class="text-sm font-medium">Google Scholar</span>
        </a>
    )}
    </div>

    <!-- Scroll indicator -->
    <a href="#experience" aria-label="Explore my experience" class="inline-block pt-5">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mx-auto text-[#64748b]"
      >
        <path d="M12 5v14" />
        <path d="M19 12l-7 7-7-7" />
      </svg>
    </a>
  </div>
  </div>
  <p class="relative lg:absolute lg:bottom-5 lg:right-6 px-6 pb-5 lg:p-0 text-center text-[10px] text-[#94a3b8]">AI-generated conceptual illustration</p>
</section>
<style>
  .hero-background { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% center; opacity: .65; }
  .hero-shade { background: linear-gradient(180deg, #0a0f1e66, #0a0f1eaa 65%, #0a0f1e); }
  .hero-actions :global(> div) { padding-top: 0; }
  .typewriter { display: inline-block; max-width: 100%; animation: type-line 1.8s steps(34, end) .25s both; }
  @keyframes type-line { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @media (prefers-reduced-motion: reduce) { .typewriter { animation: none; } }
  @media (min-width: 768px) { .hero-copy { max-width: 640px; margin-right: auto; } }
  @media (min-width: 1024px) {
    .hero { min-height: 740px; display: flex; align-items: center; }
    .hero-background { object-position: center; opacity: 1; }
    .hero-shade { background: linear-gradient(0deg, #0a0f1e, transparent 22%), linear-gradient(90deg, #0a0f1ef5 0%, #0a0f1ec9 32%, #0a0f1e33 58%, transparent 78%); }
    .hero-copy { width: 56%; max-width: 640px; }
  }
</style>
