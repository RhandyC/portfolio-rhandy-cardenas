---
import { siteConfig } from "../../config";
import { projectDetails } from "../../data/projectDetails";
import Header from "../../components/Header.astro";
import "../../styles/global.css";

export function getStaticPaths() {
  return projectDetails.map(detail => ({ params: { slug: detail.slug }, props: { detail } }));
}
const { detail } = Astro.props;
const project = siteConfig.academicProjects.find(project => project.name === detail.name)!;
const others = projectDetails.filter(item => item.slug !== detail.slug);
---
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={detail.introduction} />
    <title>{detail.name} · {siteConfig.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />
    <div class="border-b border-[#334155]">
      <nav aria-label="Project navigation" class="max-w-5xl mx-auto px-6 py-5 flex flex-wrap justify-between gap-4 text-sm">
        <a href="/" class="font-semibold text-[#e2e8f0] hover:text-[#60a5fa]">Rhandy Cardenas</a>
        <a href="/#academic-projects" class="text-[#60a5fa] hover:underline">← All projects</a>
      </nav>
    </div>
    <main class="max-w-5xl mx-auto px-6 py-12 md:py-20">
      <p class="text-xs uppercase tracking-widest text-[#60a5fa]">{detail.category}</p>
      <h1 class="mt-5 text-3xl md:text-5xl font-bold leading-tight max-w-4xl">{detail.name}</h1>
      <p class="mt-6 text-lg text-[#b8c5d8] leading-relaxed max-w-3xl">{detail.introduction}</p>
      <p class="mt-5 text-sm text-[#94a3b8]">{detail.role}</p>
      <ul aria-label="Technologies and skills" class="mt-6 flex flex-wrap gap-2">
        {project.skills.map(skill => <li class="border border-[#334155] rounded-md px-3 py-1.5 text-xs text-[#cbd5e1]">{skill}</li>)}
      </ul>
      {'images' in project && project.images?.map(photo => (
        <figure class="mt-10">
          <a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`Enlarge image: ${photo.caption}`} class="block rounded-xl border border-[#334155] bg-[#141824] overflow-hidden">
            <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} class="w-full max-h-[560px] object-contain" />
          </a>
          <figcaption class="mt-3 text-xs text-[#94a3b8]">{photo.caption}</figcaption>
        </figure>
      ))}
      <div class="mt-12 grid md:grid-cols-[minmax(0,1fr)_280px] gap-10 md:gap-14">
        <div class="space-y-10">
          <section aria-labelledby="context"><h2 id="context" class="text-2xl font-semibold mb-4">Context</h2><p class="text-sm text-[#b8c5d8] leading-loose">{detail.context}</p></section>
          <section aria-labelledby="contribution"><h2 id="contribution" class="text-2xl font-semibold mb-4">My contribution</h2><ul class="list-disc pl-5 space-y-3 text-sm text-[#b8c5d8] leading-loose marker:text-[#60a5fa]">{detail.contributions.map(item => <li>{item}</li>)}</ul></section>
        </div>
        <aside class="self-start rounded-xl border border-[#3b82f6]/40 bg-[#141824] p-6">
          <h2 class="text-lg font-semibold">Outcome</h2>
          <p class="mt-4 text-sm leading-loose text-[#b8c5d8]">{detail.outcome}</p>
          {project.link && <a href={project.link} target="_blank" rel="noopener noreferrer" class="mt-6 inline-block text-sm text-[#60a5fa] hover:underline">{project.link.includes('github.com') ? 'Explore the code ↗' : 'Visit project source ↗'}</a>}
        </aside>
      </div>
      <nav aria-label="More projects" class="mt-16 pt-8 border-t border-[#334155]">
        <h2 class="text-xl font-semibold mb-5">Explore more projects</h2>
        <div class="grid sm:grid-cols-2 gap-4">{others.map(item => <a href={`/projects/${item.slug}/`} class="rounded-xl border border-[#334155] p-5 text-sm text-[#cbd5e1] hover:border-[#60a5fa] hover:text-[#60a5fa]">{item.name} →</a>)}</div>
      </nav>
    </main>
    <footer class="border-t border-[#334155] px-6 py-8 text-center text-xs text-[#94a3b8]">{siteConfig.name} · Research, engineering & autonomous systems</footer>
  </body>
</html>
